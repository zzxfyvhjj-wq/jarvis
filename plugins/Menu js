
const { System, isPrivate, commands } = require("../lib/");

System({
    pattern: "menu",
    fromMe: isPrivate,
    type: "main",
    desc: "Custom RFK Menu",
}, async (message) => {
    let menuText = `╭━━━〔 ☭ 𝐑𝐅𝐊 𝐌𝐎𝐃𝐒 ☭ 〕━━━╮\n`;
    menuText += `┃ ☭ *𝐔𝐬𝐞𝐫 :* @${message.sender.split("@")[0]}\n`;
    menuText += `┃ ☭ *𝐁𝐨𝐭 :* 乂𝐏𝐑𝐅𝐊 𝐁𝐎𝐓乂\n`;
    menuText += `╰━━━━━━━━━━━━━━━━━━╯\n\n`;

    let cmdList = commands
        .filter((cmd) => cmd.pattern && !cmd.dontAddCommandList)
        .map((cmd) => cmd.pattern.toString().replace(/[^a-zA-Z0-9]/g, ""))
        .filter((name) => name.length > 0);

    cmdList.sort().forEach((cmd) => {
        menuText += `☭ .${cmd}\n`;
    });

    menuText += `\n╰━━━〔 ☭ 𝐂𝐘𝐁𝐄𝐑 𝐂𝐇𝐄𝐊𝐔𝐓𝐇𝐀𝐀𝐍 ☭ 〕━━━╯`;

    return await message.send(menuText, {
        mentions: [message.sender]
    });
});
